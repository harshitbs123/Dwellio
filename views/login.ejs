<!doctype html>
<html lang="en">
  <head>
    <%- include("includes/head.ejs", { title: "Sign In" }) %>
  </head>
  <body class="bg-[#030305] text-white selection:bg-pink-500 selection:text-white">
    <%- include("includes/navbar.ejs", { active: "login" }) %>

    <div class="relative overflow-hidden min-h-[calc(100vh-140px)] flex items-center justify-center px-4 py-12 sm:py-16">
      <!-- Background Ambient Glow (Vice City Neon Theme) -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[380px] bg-pink-500/10 rounded-full blur-[140px] pointer-events-none -z-10"
      ></div>

      <!-- Auth Card Container -->
      <div class="max-w-md w-full rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-2xl p-6 sm:p-8 shadow-[0_15px_45px_rgba(0,0,0,0.6)]">
        
        <!-- Header -->
        <div class="text-center mb-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-pink-500/25 bg-pink-500/10 text-pink-300 text-xs font-semibold mb-3 backdrop-blur-xl">
            <i class="fa-solid fa-lock text-[10px] text-pink-400"></i>
            <span>Secure Access</span>
          </div>

          <h1 class="zodiac-font text-2xl sm:text-3xl font-light text-white tracking-tight">
            Welcome back to
            <span class="stardom-font text-gradient-pink italic font-normal">Dwellio</span>
          </h1>

          <p class="zodiac-font text-xs text-zinc-400 mt-2 font-light leading-relaxed">
            Enter your credentials to manage your curated stays, host listings, and reservations.
          </p>
        </div>

        <!-- Login Form -->
        <form action="/login" method="POST" class="space-y-4">
          <!-- Username Field -->
          <div>
            <label for="username" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
              Username <span class="text-red-400">*</span>
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-zinc-500 text-xs">
                <i class="fa-solid fa-user"></i>
              </span>
              <input
                type="text"
                name="username"
                id="username"
                required
                autocomplete="username"
                placeholder="Enter your username"
                class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl pl-9 pr-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
              />
            </div>
          </div>

          <!-- Password Field -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400">
                Password <span class="text-red-400">*</span>
              </label>
              <a href="#" class="text-[11px] text-zinc-400 hover:text-pink-300 transition font-light">
                Forgot password?
              </a>
            </div>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-zinc-500 text-xs">
                <i class="fa-solid fa-key"></i>
              </span>
              <input
                type="password"
                name="password"
                id="password"
                required
                autocomplete="current-password"
                placeholder="Enter your password"
                class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl pl-9 pr-10 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
              />
              <button
                type="button"
                id="togglePasswordBtn"
                class="absolute right-3 text-zinc-500 hover:text-pink-300 text-xs transition cursor-pointer"
                title="Toggle password visibility"
              >
                <i id="togglePasswordIcon" class="fa-solid fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Helper Row: Remember Me -->
          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input
                type="checkbox"
                name="remember"
                class="w-3.5 h-3.5 rounded border border-white/20 bg-white/5 accent-pink-500 focus:ring-0 cursor-pointer"
              />
              <span class="text-[11px] text-zinc-400 font-light">Keep me signed in</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full py-3 rounded-full bg-gradient-to-r from-pink-500 via-rose-500 to-red-500 text-white font-semibold text-xs tracking-wider uppercase hover:shadow-[0_0_25px_rgba(255,42,133,0.55)] hover:scale-102 active:scale-98 transition cursor-pointer shadow-lg flex items-center justify-center gap-2"
            >
              <span>Sign In</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </button>
          </div>
        </form>

        <!-- Divider -->
        <div class="relative my-6 flex items-center justify-center">
          <div class="w-full border-t border-white/[0.06]"></div>
          <span class="absolute bg-[#0b0b12] px-3 text-[10px] uppercase tracking-wider text-zinc-500 font-medium">
            or
          </span>
        </div>

        <!-- Continue as Guest Option -->
        <div class="text-center">
          <a
            href="/listings"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-white/[0.03] border border-white/10 hover:border-pink-500/40 text-zinc-300 hover:text-white text-xs font-medium transition"
          >
            <i class="fa-solid fa-compass text-pink-400 text-xs"></i>
            <span>Continue exploring as Guest</span>
          </a>
        </div>

        <!-- Switch to Signup -->
        <div class="mt-6 text-center text-xs text-zinc-400 zodiac-font font-light">
          Don't have a Dwellio account?
          <a href="/signup" class="text-pink-400 hover:text-pink-300 font-medium transition ml-1 inline-flex items-center gap-1">
            <span>Create one</span>
            <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </a>
        </div>

      </div>
    </div>

    <%- include("includes/footer.ejs") %>

    <script>
      // Toggle Password Visibility
      const toggleBtn = document.getElementById("togglePasswordBtn");
      const passwordInput = document.getElementById("password");
      const toggleIcon = document.getElementById("togglePasswordIcon");

      if (toggleBtn && passwordInput && toggleIcon) {
        toggleBtn.addEventListener("click", () => {
          const isPassword = passwordInput.getAttribute("type") === "password";
          passwordInput.setAttribute("type", isPassword ? "text" : "password");
          toggleIcon.classList.toggle("fa-eye");
          toggleIcon.classList.toggle("fa-eye-slash");
        });
      }
    </script>
  </body>
</html>
