<!doctype html>
<html lang="en">
  <head>
    <%- include("includes/head.ejs", { title: "Host Your Property" }) %>
  </head>
  <body class="bg-[#030305] text-white selection:bg-pink-500 selection:text-white">
    <%- include("includes/navbar.ejs", { active: "host" }) %>

    <div class="relative overflow-hidden min-h-screen">
      <!-- Background ambient glow -->
      <div
        class="absolute top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-pink-500/8 rounded-full blur-[140px] pointer-events-none -z-10"
      ></div>

      <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
        <!-- HEADER -->
        <div class="text-center max-w-xl mx-auto mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-pink-500/25 bg-pink-500/10 text-pink-300 text-xs font-semibold mb-3 backdrop-blur-xl">
            <i class="fa-solid fa-sparkles text-[10px] text-pink-400"></i>
            <span>Dwellio Host Network</span>
          </div>

          <h1 class="zodiac-font text-3xl sm:text-4xl font-light text-white tracking-tight">
            Host your property on
            <span class="stardom-font text-gradient-pink italic font-normal">Dwellio</span>
          </h1>

          <p class="zodiac-font text-xs sm:text-sm text-zinc-400 mt-2 font-light leading-relaxed">
            Welcome travelers from around the world to your architectural villa, mountain chalet, or boutique resort.
          </p>
        </div>

        <!-- HOST FORM CONTAINER (MINIMAL GLASS) -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-2xl p-6 sm:p-8 shadow-[0_15px_45px_rgba(0,0,0,0.6)]">
          <form action="/listings" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
              <!-- LEFT COLUMN: TEXT DETAILS -->
              <div class="space-y-4">
                <!-- Title Field -->
                <div>
                  <label for="title" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                    Property Title <span class="text-red-400">*</span>
                  </label>
                  <input
                    type="text"
                    name="listing[title]"
                    id="title"
                    required
                    placeholder="e.g. Celestial Cove Coastal Villa"
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
                  />
                </div>

                <!-- Location & Country Side-by-Side -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="location" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                      Location / City <span class="text-red-400">*</span>
                    </label>
                    <input
                      type="text"
                      name="listing[location]"
                      id="location"
                      required
                      placeholder="e.g. Alibaug, Maharashtra"
                      class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
                    />
                  </div>

                  <div>
                    <label for="country" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                      Country <span class="text-red-400">*</span>
                    </label>
                    <input
                      type="text"
                      name="listing[country]"
                      id="country"
                      required
                      placeholder="e.g. India"
                      class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
                    />
                  </div>
                </div>

                <!-- Nightly Price -->
                <div>
                  <label for="price" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                    Nightly Price (₹ INR) <span class="text-red-400">*</span>
                  </label>
                  <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-pink-400 font-bold text-xs">₹</span>
                    <input
                      type="number"
                      name="listing[price]"
                      id="price"
                      min="500"
                      required
                      placeholder="e.g. 18500"
                      class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl pl-8 pr-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
                    />
                  </div>
                </div>

                <!-- Description Textarea -->
                <div>
                  <label for="description" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                    Property Description <span class="text-red-400">*</span>
                  </label>
                  <textarea
                    name="listing[description]"
                    id="description"
                    rows="4"
                    required
                    placeholder="Describe what makes your space exceptional, the views, architectural nuances, amenities, and surroundings..."
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition leading-relaxed resize-y"
                  ></textarea>
                </div>
              </div>

              <!-- RIGHT COLUMN: IMAGE URL & LIVE PREVIEW -->
              <div class="space-y-4">
                <div>
                  <label for="image" class="block text-[11px] font-bold uppercase tracking-wider text-pink-400 mb-1.5">
                    Cover Image URL
                  </label>
                  <input
                    type="url"
                    name="listing[image]"
                    id="image"
                    placeholder="https://images.unsplash.com/photo-..."
                    oninput="updateImagePreview(this.value)"
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-pink-500/60 focus:bg-zinc-950/70 transition"
                  />
                  <p class="text-[10px] text-zinc-500 mt-1 zodiac-font font-light">
                    Direct photo link (leave blank to use default luxury villa image).
                  </p>
                </div>

                <!-- Live Preview Card -->
                <div>
                  <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider mb-1.5">Live Photo Preview</span>
                  <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-white/[0.08] bg-zinc-900 flex items-center justify-center shadow-inner">
                    <img
                      id="previewImg"
                      src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80"
                      alt="Property preview"
                      class="w-full h-full object-cover transition-all duration-300"
                    />
                    <div id="previewBadge" class="absolute bottom-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[9px] font-semibold bg-black/70 backdrop-blur-md text-pink-300 border border-pink-500/30">
                      Live Preview
                    </div>
                  </div>

                  <!-- Quick Sample Presets -->
                  <div class="mt-2.5">
                    <span class="text-[10px] text-zinc-400 font-light zodiac-font">Sample presets:</span>
                    <div class="flex flex-wrap gap-1.5 mt-1">
                      <button
                        type="button"
                        onclick="setSampleImage('https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80')"
                        class="px-2 py-0.5 rounded-md bg-white/[0.03] hover:bg-pink-500/15 text-zinc-300 hover:text-pink-300 border border-white/[0.06] text-[10px] transition cursor-pointer"
                      >
                        Coastal Villa
                      </button>
                      <button
                        type="button"
                        onclick="setSampleImage('https://images.unsplash.com/photo-1518780664697-55e3ad937233?auto=format&fit=crop&w=1200&q=80')"
                        class="px-2 py-0.5 rounded-md bg-white/[0.03] hover:bg-pink-500/15 text-zinc-300 hover:text-pink-300 border border-white/[0.06] text-[10px] transition cursor-pointer"
                      >
                        Mountain Chalet
                      </button>
                      <button
                        type="button"
                        onclick="setSampleImage('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1200&q=80')"
                        class="px-2 py-0.5 rounded-md bg-white/[0.03] hover:bg-pink-500/15 text-zinc-300 hover:text-pink-300 border border-white/[0.06] text-[10px] transition cursor-pointer"
                      >
                        Glamping Resort
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Host Protection Strip -->
                <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] flex items-center gap-2.5 text-xs text-zinc-400">
                  <i class="fa-solid fa-shield-heart text-pink-400 text-lg flex-shrink-0"></i>
                  <p class="font-light zodiac-font leading-relaxed text-[11px]">
                    <strong class="text-white font-medium">Host Protection:</strong> Every host on Dwellio is covered with property damage reassurance and 24/7 priority concierge.
                  </p>
                </div>
              </div>
            </div>

            <!-- SUBMIT & CANCEL BUTTONS -->
            <div class="pt-5 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-3">
              <a
                href="/listings"
                class="text-xs text-zinc-400 hover:text-white transition flex items-center gap-1.5 zodiac-font font-light"
              >
                <i class="fa-solid fa-arrow-left text-[9px]"></i>
                <span>Cancel and return</span>
              </a>

              <button
                type="submit"
                class="w-full sm:w-auto px-8 py-3 rounded-full bg-gradient-to-r from-pink-500 via-rose-500 to-red-500 text-white font-bold text-xs tracking-wide shadow-[0_0_20px_rgba(255,42,133,0.45)] hover:shadow-[0_0_30px_rgba(255,42,133,0.7)] hover:scale-102 active:scale-98 transition cursor-pointer flex items-center justify-center gap-2"
              >
                <i class="fa-solid fa-cloud-arrow-up text-[11px]"></i>
                <span>Publish Listing on Dwellio</span>
              </button>
            </div>
          </form>
        </div>
      </main>
    </div>

    <script>
      function updateImagePreview(url) {
        const img = document.getElementById("previewImg");
        if (url && url.trim() !== "") {
          img.src = url;
          img.onerror = () => {
            img.src = "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80";
          };
        } else {
          img.src = "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80";
        }
      }

      function setSampleImage(url) {
        const input = document.getElementById("image");
        input.value = url;
        updateImagePreview(url);
      }
    </script>

    <%- include("includes/footer.ejs") %>
  </body>
</html>
