<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dwellio</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>
  <body class="bg-black zodiac-font">
    <style>
      /* zodiac */
      @font-face {
        font-family: "zodiac";
        src: url("./assets/fonts/Zodiak-Thin.otf") format("opentype");
        font-weight: 100;
      }

      @font-face {
        font-family: "zodiac";
        src: url("./assets/fonts/Zodiak-Light.otf") format("opentype");
        font-weight: 300;
      }

      @font-face {
        font-family: "zodiac";
        src: url("./assets/fonts/Zodiak-Regular.otf") format("opentype");
        font-weight: 400;
      }

      @font-face {
        font-family: "zodiac";
        src: url("./assets/fonts/Zodiak-Bold.otf") format("opentype");
        font-weight: 700;
      }

      @font-face {
        font-family: "zodiac";
        src: url("./assets/fonts/Zodiak-Extrabold.otf") format("opentype");
        font-weight: 800;
      }
      .zodiac-font {
        font-family: "zodiac", sans-serif;
      }
    </style>

    <div class="bg-black p-5 zodiac-font font-light">
      <nav
        class="flex justify-between mx-10 items-center p-4 rounded-full bg-gradient-to-br from-pink-500 via-rose-400 to-red-300"
      >
        <div class="flex-1 mx-5">
          <a href="/listings">
            <span class="text-white bg-black px-4 py-2 rounded-xl">
              <i class="text-[#d9659a] text-2xl">D</i>wellio
            </span>
          </a>
        </div>
        <div
          class="flex flex-1 justify-center text-sm text-white border p-4 rounded-full bg-red-800/10 backdrop-blur-sm border border-white/40"
        >
          <div class="mx-4">
            <a href="/listings">All</a>
          </div>
          <div class="mx-4">Homes</div>
          <div class="mx-4">Resorts</div>
          <div class="mx-4">
            <a href="/listings/host">Host</a>
          </div>
        </div>
        <div class="flex items-center flex-1 justify-end text-white">
          <div
            class="mx-4 border p-2 px-3 text-sm rounded-full bg-red-800/10 backdrop-blur-sm border border-white/40"
          >
            <a href="/listings/host"><span> Become a host </span></a>
          </div>
          <div
            class="mx-2 p-3 rounded-full bg-black h-10 w-10 flex items-center justify-center"
          >
            <i class="fa-solid fa-globe text-[#d9659a]"></i>
          </div>
          <div
            class="mx-2 p-3 rounded-full bg-black h-10 w-10 flex items-center justify-center"
          >
            <i class="fa-solid fa-bars-staggered text-[#d9659a]"></i>
          </div>
        </div>
      </nav>
    </div>
    <!-- content -->
    <div class="content w-[80%] mx-auto text-white zodiac-font">
      <!-- listing head -->
      <div class="listingsheading mt-5">
        <h1 class="zodiac-font text-4xl font-light">
          Host your hotel on
          <span
            class="stardom-font ( bg-gradient-to-r from-pink-500 to-red-400 ) px-2 rounded-xl font-light"
            ><i class="font-bold">D</i>wellio now..</span
          >
        </h1>
      </div>
      <!-- Host info enter box-->
      <div
        class="border flex justify-center items-center m-2 mt-7 p-3 rounded-xl bg-pink-300/10 hover:bg-pink-600/10 transition duration-300 zodiac-font"
      >
        <div class="data mt-2 p-5 flex font-thin flex justify-center items-center">
          <form action="/listings/<%= listing._id %>?_method=PATCH" method="POST">
            <div class="title">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Hotel Title :
              </h1>
              <input
                type="text"
                name="listing[title]"
                placeholder="Enter Title"
                id=""
                value="<%= listing.title %>"
                class="border w-100 h-10 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
              />
            </div>
            <div class="description mt-5">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Description :
              </h1>
              <textarea
                type="text"
                name="listing[description]"
                id=""
                placeholder="Tell us about your property"
                class="border w-100 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
                rows="4"
              ><%= listing.description %></textarea>
            </div>
            <div class="location mt-5">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Location :
              </h1>
              <input
                type="text"
                name="listing[location]"
                id=""
                placeholder="Where is it located"
                value="<%= listing.location %>"
                class="border w-100 h-10 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
              />
            </div>
            <div class="country mt-5">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Country :
              </h1>
              <input
                type="text"
                name="listing[country]"
                id=""
                placeholder="Enter Country"
                value="<%= listing.country %>"
                class="border w-100 h-10 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
              />
            </div>
            <div class="price mt-5">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Hotel Price :
              </h1>
              <input
                type="number"
                name="listing[price]"
                id=""
                placeholder="How much for a night"
                value="<%= listing.price %>"
                class="border w-100 h-10 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
              />
            </div>
            <div class="image_url mt-5">
              <h1
                class="mb-4 text-xl bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                Hotel Image URL :
              </h1>
              <input
                type="text"
                name="listing[image]"
                id=""
                placeholder="Show us the establishment"
                value="<%= listing.image %>"
                class="border w-100 h-10 rounded-3xl px-5 py-3 bg-gradient-to-r from-pink-500/10 to-red-500/10"
              />
            </div>
            <div class="submit flex align-center justify-center mt-5">
              <span class="bg-black py-2 rounded-3xl">
                <button
                  class="bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent px-7 text-xl font-bold"
                >
                  Update Info
                </button>
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>

    <footer
      class="mt-20 bg-gradient-to-br from-pink-500 via-rose-400 to-red-300 text-white"
      id="about"
    >
      <div
        class="mx-auto grid w-[80%] gap-10 py-12 md:grid-cols-[1.4fr_1fr] md:items-end"
      >
        <div>
          <p class="stardom-font text-3xl font-light tracking-wide">
            <span class="border bg-white rounded-2xl px-3 py-1">
              <span
                class="bg-gradient-to-r from-pink-500 to-red-500 bg-clip-text text-transparent"
              >
                <i class="font-bold">D</i>wellio
              </span>
            </span>
          </p>
          <p class="zodiac-font mt-8 text-xs text-white/70">
            2026 Dwellio. All rights reserved.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div
            class="rounded-2xl border border-white/30 bg-white/15 p-4 backdrop-blur-sm"
          >
            <strong class="stardom-font block text-2xl">4.9/5</strong>
            <span class="zodiac-font mt-1 block text-xs text-white/75"
              >Average rating</span
            >
          </div>
          <div
            class="rounded-2xl border border-white/30 bg-white/15 p-4 backdrop-blur-sm"
          >
            <strong class="stardom-font block text-2xl">12k+</strong>
            <span class="zodiac-font mt-1 block text-xs text-white/75"
              >Places to stay</span
            >
          </div>
          <div
            class="rounded-2xl border border-white/30 bg-white/15 p-4 backdrop-blur-sm"
          >
            <strong class="stardom-font block text-2xl">24/7</strong>
            <span class="zodiac-font mt-1 block text-xs text-white/75"
              >Guest support</span
            >
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
