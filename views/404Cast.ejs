<!doctype html>
<html lang="en">
  <head>
    <%- include("includes/head.ejs", { title: "Listing Not Found" }) %>
  </head>
  <body class="bg-[#030305] text-white selection:bg-pink-500 selection:text-white">
    <%- include("includes/navbar.ejs") %>

    <div class="relative overflow-hidden min-h-[70vh] flex items-center justify-center px-4 py-16">
      <!-- Background ambient glow -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-pink-500/10 rounded-full blur-[140px] pointer-events-none -z-10"
      ></div>

      <div
        class="max-w-md w-full text-center p-8 rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-2xl shadow-[0_15px_45px_rgba(0,0,0,0.6)]"
      >
        <div class="w-12 h-12 rounded-2xl bg-pink-500/10 border border-pink-500/25 flex items-center justify-center text-pink-400 text-lg mx-auto mb-3 shadow-[0_0_15px_rgba(255,42,133,0.2)]">
          <i class="fa-solid fa-hotel"></i>
        </div>

        <h1 class="stardom-font text-4xl sm:text-5xl font-normal text-gradient-pink tracking-tight my-2">
          Listing Not Found
        </h1>

        <p class="zodiac-font text-xs text-zinc-400 mt-2 font-light leading-relaxed max-w-sm mx-auto">
          The property ID you entered does not exist or may have been unlisted by the host. Check out our other extraordinary destinations!
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/listings"
            class="px-6 py-2.5 rounded-full bg-gradient-to-r from-pink-500 via-rose-500 to-red-500 text-white font-semibold text-xs shadow-[0_0_18px_rgba(255,42,133,0.45)] hover:scale-102 active:scale-98 transition"
          >
            Explore All Listings
          </a>
          <a
            href="/"
            class="px-5 py-2.5 rounded-full bg-white/[0.03] border border-white/10 text-zinc-300 hover:text-white hover:border-pink-500/40 text-xs font-medium transition"
          >
            Go to Homepage
          </a>
        </div>
      </div>
    </div>

    <%- include("includes/footer.ejs") %>
  </body>
</html>
