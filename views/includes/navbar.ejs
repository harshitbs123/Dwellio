<!-- Ambient Glassmorphism Floating Glow Orbs (Behind content) -->
<div class="fixed inset-0 pointer-events-none overflow-hidden -z-20">
  <div class="glass-glow-orb orb-pink"></div>
  <div class="glass-glow-orb orb-purple"></div>
  <div class="glass-glow-orb orb-cyan"></div>
  <div class="glass-glow-orb orb-sunset"></div>
</div>

<!-- Sleek, Minimal, Luxury Vice City Navbar -->
<header class="sticky top-0 z-50 py-2 sm:py-2.5 px-3 sm:px-6 backdrop-blur-xl bg-black/10 border-b border-white/[0.04] transition-all duration-300">
  <nav
    class="max-w-5xl mx-auto px-4 sm:px-5 py-1.5 sm:py-2 rounded-full bg-[#08080c]/80 backdrop-blur-2xl border border-white/[0.08] hover:border-pink-500/25 shadow-[0_4px_24px_rgba(0,0,0,0.6),0_0_15px_rgba(255,42,133,0.08)] flex items-center justify-between transition-all duration-300"
  >
    <!-- Left: Sleek Glowing Vice City Logo -->
    <div class="flex-shrink-0 flex items-center">
      <a href="/" class="flex items-center group py-0.5">
        <div class="logo-wrapper transition-all duration-300">
          <img
            src="/logo.png"
            alt="Dwellio"
            class="h-7 sm:h-8 w-auto object-contain dwellio-nav-logo filter drop-shadow-[2px_2px_15px_rgba(255,42,133,0.6)] group-hover:scale-105 transition-all duration-200"
            onerror="this.style.display='none'; document.getElementById('textLogo').classList.remove('hidden');"
          />
        </div>
        <span id="textLogo" class="hidden items-center text-white tracking-tight font-medium text-base">
          <i class="text-[#ff2a85] text-xl stardom-font not-italic mr-0.5">D</i><span class="zodiac-font">wellio</span>
        </span>
      </a>
    </div>

    <!-- Center: Minimal Clean Navigation Links -->
    <div
      class="hidden md:flex items-center space-x-6 text-xs zodiac-font font-light tracking-wide text-zinc-300"
    >
      <a
        href="/"
        class="transition hover:text-pink-300 <%= (typeof active !== 'undefined' && active === 'home') ? 'text-pink-400 font-semibold' : 'hover:text-white' %>"
      >
        Home
      </a>
      <a
        href="/listings"
        class="transition hover:text-pink-300 <%= (typeof active !== 'undefined' && active === 'listings') ? 'text-pink-400 font-semibold' : 'hover:text-white' %>"
      >
        All Stays
      </a>
      <a
        href="/listings?search=Villa"
        class="transition hover:text-pink-300 <%= (typeof active !== 'undefined' && active === 'villas') ? 'text-pink-400 font-semibold' : 'hover:text-white' %>"
      >
        Villas
      </a>
      <a
        href="/listings?search=Resort"
        class="transition hover:text-pink-300 <%= (typeof active !== 'undefined' && active === 'beachfront') ? 'text-pink-400 font-semibold' : 'hover:text-white' %>"
      >
        Resorts
      </a>
      <a
        href="/listings/host"
        class="transition hover:text-pink-300 <%= (typeof active !== 'undefined' && active === 'host') ? 'text-pink-400 font-semibold' : 'hover:text-white' %>"
      >
        Host
      </a>
    </div>

    <!-- Right: Minimal Sleek Controls -->
    <div class="flex items-center gap-2">
      <!-- Become a Host Pill -->
      <a
        href="/listings/host"
        class="px-3.5 py-1.5 rounded-full text-[11px] font-medium text-pink-300 border border-pink-500/30 bg-pink-500/10 hover:bg-pink-500/20 hover:border-pink-500/60 hover:text-white transition duration-200 shadow-[0_0_12px_rgba(255,42,133,0.15)] flex items-center gap-1.5"
      >
        <i class="fa-solid fa-sparkles text-[9px] text-pink-400"></i>
        <span>Become a host</span>
      </a>

      <!-- Apple macOS Glass Theme Toggle (Light / Dark) -->
      <button
        id="themeToggleBtn"
        type="button"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full theme-toggle-btn border flex items-center justify-center transition-all duration-300 cursor-pointer"
        title="Toggle Theme: macOS Glass Light / Vice City Dark"
        aria-label="Toggle light and dark theme"
      >
        <i class="theme-icon-dark fa-solid fa-moon text-xs text-pink-400"></i>
        <i class="theme-icon-light fa-solid fa-sun text-xs text-amber-500 hidden"></i>
      </button>

      <!-- Quick Explore Globe -->
      <a
        href="/listings"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/[0.03] border border-white/10 hover:border-pink-500/40 text-zinc-400 hover:text-pink-400 flex items-center justify-center transition"
        title="Explore all stays"
      >
        <i class="fa-solid fa-globe text-xs"></i>
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobileMenuBtn"
        type="button"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/[0.03] border border-white/10 text-zinc-400 hover:text-pink-400 md:hidden flex items-center justify-center transition cursor-pointer"
        aria-label="Toggle navigation menu"
      >
        <i class="fa-solid fa-bars-staggered text-xs"></i>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobileMenu"
    class="hidden md:hidden max-w-5xl mx-auto mt-2 p-4 rounded-2xl bg-[#08080c]/95 border border-white/10 backdrop-blur-2xl shadow-[0_15px_40px_rgba(0,0,0,0.85)] transition-all"
  >
    <div class="flex flex-col space-y-2 zodiac-font text-xs text-zinc-300">
      <a
        href="/"
        class="px-3 py-2 rounded-xl hover:bg-pink-500/10 hover:text-pink-300 transition flex items-center justify-between"
      >
        <span>Home</span>
        <i class="fa-solid fa-chevron-right text-[10px] text-pink-400/50"></i>
      </a>
      <a
        href="/listings"
        class="px-3 py-2 rounded-xl hover:bg-pink-500/10 hover:text-pink-300 transition flex items-center justify-between"
      >
        <span>All Stays</span>
        <i class="fa-solid fa-chevron-right text-[10px] text-pink-400/50"></i>
      </a>
      <a
        href="/listings?search=Villa"
        class="px-3 py-2 rounded-xl hover:bg-pink-500/10 hover:text-pink-300 transition flex items-center justify-between"
      >
        <span>Villas</span>
        <i class="fa-solid fa-chevron-right text-[10px] text-pink-400/50"></i>
      </a>
      <a
        href="/listings?search=Resort"
        class="px-3 py-2 rounded-xl hover:bg-pink-500/10 hover:text-pink-300 transition flex items-center justify-between"
      >
        <span>Resorts</span>
        <i class="fa-solid fa-chevron-right text-[10px] text-pink-400/50"></i>
      </a>
      <a
        href="/listings/host"
        class="px-3 py-2 rounded-xl bg-pink-500/15 border border-pink-500/35 text-pink-300 font-semibold transition flex items-center justify-between"
      >
        <span class="flex items-center gap-2">
          <i class="fa-solid fa-plus text-[10px]"></i>
          Host Your Property
        </span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>

      <!-- Theme Switcher in Mobile Menu -->
      <button
        id="mobileThemeBtn"
        type="button"
        class="w-full text-left px-3 py-2.5 rounded-xl hover:bg-pink-500/10 hover:text-pink-300 transition flex items-center justify-between cursor-pointer border border-white/5"
      >
        <span class="flex items-center gap-2">
          <i class="theme-icon-dark fa-solid fa-moon text-xs text-pink-400"></i>
          <i class="theme-icon-light fa-solid fa-sun text-xs text-amber-500 hidden"></i>
          <span class="theme-toggle-text">Switch to Light Mode</span>
        </span>
        <span class="text-[10px] px-2.5 py-0.5 rounded-full border border-pink-500/30 text-pink-400 theme-badge-text font-medium">macOS Glass</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const mobileBtn = document.getElementById("mobileMenuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }

  // Theme Switcher Controller
  (function () {
    const themeBtn = document.getElementById("themeToggleBtn");
    const mobileThemeBtn = document.getElementById("mobileThemeBtn");
    const darkIcons = document.querySelectorAll(".theme-icon-dark");
    const lightIcons = document.querySelectorAll(".theme-icon-light");
    const themeTexts = document.querySelectorAll(".theme-toggle-text");
    const themeBadges = document.querySelectorAll(".theme-badge-text");

    function syncThemeUI(theme) {
      if (theme === "light") {
        darkIcons.forEach((i) => i.classList.add("hidden"));
        lightIcons.forEach((i) => i.classList.remove("hidden"));
        themeTexts.forEach((t) => (t.textContent = "Switch to Dark Mode"));
        themeBadges.forEach((b) => (b.textContent = "Vice City"));
      } else {
        darkIcons.forEach((i) => i.classList.remove("hidden"));
        lightIcons.forEach((i) => i.classList.add("hidden"));
        themeTexts.forEach((t) => (t.textContent = "Switch to Light Mode"));
        themeBadges.forEach((b) => (b.textContent = "macOS Glass"));
      }
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("dwellio_theme", next);
      } catch (e) {}
      syncThemeUI(next);
    }

    if (themeBtn) themeBtn.addEventListener("click", toggleTheme);
    if (mobileThemeBtn) mobileThemeBtn.addEventListener("click", toggleTheme);

    // Initial sync with active data-theme
    const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
    syncThemeUI(currentTheme);
  })();
</script>
